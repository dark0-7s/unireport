{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile representation for authenticated reporters and organizers",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique user ID matching Firebase Auth UID" },
        "name": { "type": "string", "description": "Full display name of reporter", "maxLength": 150 },
        "email": { "type": "string", "description": "Verified email address of reporter", "format": "email", "maxLength": 200 },
        "photoURL": { "type": "string", "description": "User avatar photo URL", "maxLength": 500 },
        "organization": { "type": "string", "description": "Academic department or institution name", "maxLength": 200 },
        "createdAt": { "type": "string", "description": "Creation timestamp ISO string" },
        "reportOrder": { "type": "array", "description": "Custom ordered list of report IDs for the user's dashboard" }
      },
      "required": ["id", "name", "email"]
    },
    "Report": {
      "title": "Report",
      "description": "Institutional event documentation and reports",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Unique report identifier", "maxLength": 128 },
        "userId": { "type": "string", "description": "Firebase Auth UID of report owner", "maxLength": 128 },
        "title": { "type": "string", "description": "Title of the event report", "maxLength": 250 },
        "status": { "type": "string", "description": "Report workflow state", "enum": ["draft", "completed"] },
        "createdAt": { "type": "string", "description": "Creation timestamp" },
        "updatedAt": { "type": "string", "description": "Last update timestamp" }
      },
      "required": ["id", "userId", "title", "status"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Public reporter profile for authenticated users"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Collection of event reports created and managed by owners"
    }
  }
}
