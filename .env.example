# UniReport Environment Variables Template

# Server Port
PORT=3000

# Node Environment ('development' or 'production')
NODE_ENV=development

# Google Gemini API Key (Required for REGAN, Copilot, Summarizer, and Auto-tagger)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Configurable Gemini Model Aliases (Defaults to gemini-3.8-flash)
GEMINI_MODEL=gemini-3.8-flash

# Firebase Client Configuration (Optional - Application falls back gracefully to localStorage)
# Required for real-time cloud multi-device sync & Google 1-Click Auth
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
